{
  "name": "@civitas/esm-character-app",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "EGEN Character Factory dans EGEN : enveloppe d'application externe (iframe + configuration runtime) affichant une instance de Character Factory (création de personnages 3D) déployée à une adresse connue dans la zone principale du Core.",
  "browser": "dist/civitas-esm-character-app.js",
  "main": "src/index.ts",
  "source": true,
  "files": [
    "dist",
    "src",
    "translations"
  ],
  "scripts": {
    "start": "egen develop",
    "serve": "rspack serve --mode=development",
    "build": "rspack --mode=production",
    "build:development": "rspack --mode=development",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "typescript": "tsc",
    "pack:tarball": "npm pack"
  },
  "keywords": [
    "egen",
    "microfrontends",
    "character",
    "3d"
  ],
  "browserslist": [
