# EGEN Character Factory — site statique (modèle nginx : rendu au démarrage par l'image nginx, variables d'environnement substituées).
# Ce fichier est inclus dans le contexte http : ces types s'ajoutent à /etc/nginx/mime.types.
# (.vrm / .fbx : application/octet-stream par défaut ; .wasm est déjà déclaré.)
types {
  model/gltf-binary glb;
  image/ktx2 ktx2;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_vary on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types application/javascript text/css application/json image/svg+xml application/wasm text/plain;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # EGEN : embarquement en iframe dans le Core (CHARACTER_FRAME_ANCESTORS, voir docker/15-egen-frame-ancestors.envsh).
  # Valeur vide = en-tête absent = comportement d'origine.
  add_header Content-Security-Policy "${CHARACTER_FRAME_CSP}" always;

  # Sonde de santé
  location = /health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Point d'entrée et manifestes de personnages : toujours revalidés
  location = /index.html { expires -1; }
  location ~ ^/(manifest[^/]*\.json)$ { expires -1; }

  # Bundles Vite (nom + empreinte) : cache long
  location ~ "^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css)$" { expires 1y; }

  # Bibliothèque de personnages (volume séparé, optionnel) — jamais embarquée dans l'image
  location ^~ /loot-assets/ {
    alias /srv/loot-assets/;
    autoindex off;
    expires 1h;
  }

  # Pas de repli SPA : un asset absent doit répondre 404 (et non index.html)
  location / {
    try_files $uri $uri/ =404;
    expires 1d;
  }
}
